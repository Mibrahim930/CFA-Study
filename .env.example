# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# YouTube Data API v3 — metadata only (playlist titles/durations) for the video map.
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# Anthropic — lesson/question generation and verification (server-side only).
# console.anthropic.com → API keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
# Hard cap enforced by the app's content pipeline (USD per month).
CLAUDE_MONTHLY_BUDGET_USD=25

# Supabase — database + login (added in the sync milestone).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only this email can sign in.
ALLOWED_EMAIL=
