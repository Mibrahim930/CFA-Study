# Copy to .env.local (git-ignored) and fill in. Never commit real keys.

# YouTube Data API v3 — metadata only (playlist titles/durations) for the video map.
# Google Cloud Console → APIs & Services → enable "YouTube Data API v3" → Credentials → API key.
YOUTUBE_API_KEY=

# Anthropic — lesson/question generation and verification (server-side only).
# console.anthropic.com → API keys. Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
# Hard cap enforced by the app's content pipeline (USD per month).
CLAUDE_MONTHLY_BUDGET_USD=25

# Accounts and progress sync (optional). A Postgres connection string turns on /account: sign in from
# any device and progress lives in the account. Railway injects this when a Postgres service is linked
# (docs/DEPLOY.md). Leave it empty to keep the app per device. For local work, any Postgres works, e.g.
# DATABASE_URL=postgres://postgres@127.0.0.1:5432/l1dev
DATABASE_URL=
# Integration tests for lib/server run only when this is set (a throwaway database):
# TEST_DATABASE_URL=postgres://postgres@127.0.0.1:5432/l1test
